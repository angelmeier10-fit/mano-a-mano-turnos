rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada profesional tiene su negocio en businesses/{bizId}; todo lo suyo vive adentro.
    // El público (app de reservas, sin login) puede leer servicios y disponibilidad y reservar.
    // Solo el dueño del negocio (ownerUid) lee la lista de turnos/clientes y edita.

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(bizId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerUid == request.auth.uid;
    }

    // El dueño de mano-a-mano administra la plataforma (precios, cobros y registro).
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/businesses/mano-a-mano).data.ownerUid == request.auth.uid;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    // Misma regla que subscriptionStatus en shared/helpers.js. Sin createdAt ni activeUntil el negocio
    // está exento. Con vencimiento: 7 días de gracia (604800000 ms). Con prueba: 30 + 7 días (3196800000 ms).
    function acceptsNew(bizId) {
      let biz = get(/databases/$(database)/documents/businesses/$(bizId)).data;
      let now = request.time.toMillis();
      let created = biz.get('createdAt', null);
      let until = biz.get('activeUntil', null);
      return biz.get('exempt', false) == true
        || (created == null && until == null)
        || (until != null && until + 604800000 > now)
        || (created != null && created.toMillis() + 3196800000 > now);
    }

    match /appConfig/{docId} {
      allow get: if true;
      allow write: if isAdmin();
    }

    // Un negocio por cuenta: se crea junto con el negocio y no se puede borrar.
    match /businessOwners/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create: if isVerified()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['bizId'])
                    && getAfter(/databases/$(database)/documents/businesses/$(request.resource.data.bizId)).data.ownerUid == uid;
    }

    match /billing/{bizId} {
      allow get: if isOwner(bizId) || isAdmin();
      allow list, update: if isAdmin();
      allow create: if isAdmin()
                    || (isVerified()
                        && request.resource.data.keys().hasOnly(['ownerEmail', 'plan', 'termsAcceptedAt'])
                        && request.resource.data.plan == 'regular'
                        && request.resource.data.ownerEmail == request.auth.token.email
                        && request.resource.data.termsAcceptedAt == request.time
                        && !exists(/databases/$(database)/documents/businessOwners/$(request.auth.uid))
                        && getAfter(/databases/$(database)/documents/businesses/$(bizId)).data.ownerUid == request.auth.uid);
    }

    // El alta crea negocio, billing y businessOwners en el mismo batch. El dueño no puede
    // cambiar ownerUid ni los campos de suscripción; el admin solo cambia estos últimos.
    match /businesses/{bizId} {
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isVerified()
                    && get(/databases/$(database)/documents/appConfig/billing).data.signupOpen == true
                    && bizId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
                    && bizId.size() >= 3 && bizId.size() <= 40
                    && !(bizId in ['admin', 'agenda', 'reservas', 'www', 'api', 'test', 'soporte'])
                    && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt', 'showQuiz', 'whatsapp'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && !exists(/databases/$(database)/documents/businessOwners/$(request.auth.uid))
                    && getAfter(/databases/$(database)/documents/businessOwners/$(request.auth.uid)).data.bizId == bizId
                    && existsAfter(/databases/$(database)/documents/billing/$(bizId));
      allow update: if (isOwner(bizId)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'createdAt', 'activeUntil', 'exempt']))
                    || (isAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeUntil', 'exempt']));

      match /services/{serviceId} {
        allow read: if true;
        allow write: if isOwner(bizId);
      }

      match /locations/{locId} {
        allow read: if true;
        allow write: if isOwner(bizId);
      }

      match /availability/{slotId} {
        allow read: if true;
        allow write: if isOwner(bizId);
        // App pública: marcar un cupo como reservado al confirmar turno.
        allow update: if !resource.data.get('booked', false)
                      && request.resource.data.booked == true
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked']);
        // App pública: liberar un cupo al cancelar o reprogramar un turno.
        allow update: if resource.data.get('booked', false)
                      && request.resource.data.booked == false
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked']);
        // App pública: ocupar o liberar un horario dentro de una franja, de a un turno por vez.
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['busy'])
                      && request.resource.data.busy is list
                      && request.resource.data.busy.size() - resource.data.get('busy', []).size() in [1, -1];
      }

      match /appointments/{apptId} {
        // cualquiera puede crear una reserva (vía la app pública)
        allow create: if acceptsNew(bizId)
                      && (request.resource.data.status == "confirmado"
                          || request.resource.data.status == "pendiente")
                      && request.resource.data.clientName is string
                      && request.resource.data.clientName.size() > 0;
        // solo el dueño podés leer la lista completa, editar o borrar
        allow read, update, delete: if isOwner(bizId);
        // Cliente sin login puede cancelar/reprogramar su propio turno.
        // Solo se permite cambiar status y cancelProof, y únicamente si el turno está activo.
        // - Reserva pública (tiene cancelToken): exige cancelProof correcto como prueba de identidad.
        // - Turno manual sin cancelToken (cargado por el profesional): se permite sin prueba adicional.
        // - También se permite si cancelProof es el teléfono con el que el cliente encontró
        //   el turno (existe phoneIndex/{cancelProof}/bookings/{apptId}): cubre turnos viejos
        //   o desincronizados donde el cancelToken guardado no coincide.
        allow update: if !isOwner(bizId)
                      && (resource.data.status == "confirmado" || resource.data.status == "pendiente")
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelProof'])
                      && (
                           (resource.data.get('cancelToken', null) != null
                            && request.resource.data.cancelProof == resource.data.cancelToken)
                           || resource.data.get('cancelToken', null) == null
                           || (request.resource.data.cancelProof is string
                               && request.resource.data.cancelProof.size() > 0
                               && exists(/databases/$(database)/documents/businesses/$(bizId)/phoneIndex/$(request.resource.data.cancelProof)/bookings/$(apptId)))
                         );
      }

      match /clients/{clientId} {
        // cualquiera puede crear su propia ficha al reservar (vía la app pública)
        allow create: if request.resource.data.name is string
                      && request.resource.data.name.size() > 0;
        // los datos de clientes son privados: solo el dueño los lee, editás o borrás
        allow read, update, delete: if isOwner(bizId);
      }


      // Gift Cards: cualquiera puede crear y leer por código. Solo autenticado puede actualizar (activar/canjear).
      match /giftCards/{code} {
        allow create: if acceptsNew(bizId)
                      && request.resource.data.status == "pending"
                      && request.resource.data.fromName is string
                      && request.resource.data.fromName.size() > 0
                      && request.resource.data.buyerPhone is string
                      && request.resource.data.buyerPhone.size() > 0;
        allow read: if true;
        allow update: if isOwner(bizId)
                      || (
                        // Cliente puede canjear: cambiar status a "used" y agregar apptId
                        resource.data.status == "active"
                        && request.resource.data.status == "used"
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'apptId', 'usedAt'])
                      )
                      || (
                        // Cliente puede restaurar al cancelar: volver a "active" y limpiar apptId/usedAt
                        resource.data.status == "used"
                        && request.resource.data.status == "active"
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'apptId', 'usedAt'])
                      )
                      || (
                        // Cliente puede actualizar apptId al reprogramar (gift card sigue "used")
                        resource.data.status == "used"
                        && request.resource.data.status == "used"
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apptId'])
                      );
        allow delete: if isOwner(bizId);
      }

      // Combos de sesiones prepagas: cualquiera puede pedir uno (queda "pending" hasta que
      // el profesional confirma el pago). Solo autenticado puede activar/canjear/borrar.
      match /combos/{comboId} {
        allow create: if acceptsNew(bizId)
                      && request.resource.data.status == "pending"
                      && request.resource.data.clientName is string
                      && request.resource.data.clientName.size() > 0
                      && request.resource.data.clientPhone is string
                      && request.resource.data.clientPhone.size() > 0
                      && (request.resource.data.totalSessions == 2 || request.resource.data.totalSessions == 3);
        allow read: if true;
        allow update: if isOwner(bizId)
                      || (
                        // Cliente puede canjear una sesión al reservar: baja sessionsRemaining en 1
                        // y actualiza status/usedApptIds.
                        resource.data.status == "active"
                        && request.resource.data.sessionsRemaining == resource.data.sessionsRemaining - 1
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sessionsRemaining', 'usedApptIds'])
                      )
                      || (
                        // Cliente puede restaurar una sesión al cancelar: sube sessionsRemaining en 1
                        // y vuelve a "active".
                        request.resource.data.status == "active"
                        && request.resource.data.sessionsRemaining == resource.data.sessionsRemaining + 1
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sessionsRemaining', 'usedApptIds'])
                      )
                      || (
                        // Cliente puede actualizar el apptId dentro de usedApptIds al reprogramar.
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedApptIds'])
                      );
        allow delete: if isOwner(bizId);
      }

      // Índice liviano para deduplicar clientes desde la app pública sin exponer datos sensibles.
      // ID del documento = dígitos del teléfono. Solo contiene { clientId }.
      match /phoneIndex/{phoneDigitsId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isOwner(bizId);
      }

      // Índice de reservas por teléfono: permite al cliente ver y gestionar sus turnos sin login.
      // No almacena cancelToken (ese solo vive en localStorage del cliente).
      match /phoneIndex/{phoneDigitsId}/bookings/{apptId} {
        allow read, write: if true;
      }

      // Índice liviano público con el descuento VIP del cliente, sin datos sensibles.
      // ID del documento = dígitos del teléfono.
      match /clientDiscounts/{phoneDigitsId} {
        allow read: if true;
        allow write: if isOwner(bizId);
      }

      // Crédito por recomendar (copia pública de clients.referralCredit). Solo lo escribe
      // el profesional desde la agenda; reservas-app solo lo lee para mostrar el aviso.
      match /referralCredits/{phoneDigitsId} {
        allow read: if true;
        allow write: if isOwner(bizId);
      }

      // Fichas de sesiones del cliente: solo el dueño.
      match /clients/{clientId}/sessions/{sessionId} {
        allow read, write: if isOwner(bizId);
      }

      // Historial de movimientos: reservas (sin login) agrega eventos al cancelar/reprogramar.
      match /appointmentHistory/{eventId} {
        allow create: if true;
        allow read, update, delete: if isOwner(bizId);
      }
    }
  }
}
